# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/rishta_db

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_123!
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_456!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Sending (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=no-reply@rishtaapp.com
FROM_NAME="Rishta Matrimonial"

# Firebase Cloud Messaging & App Check
FIREBASE_PROJECT_ID=rishta-app-8ae0d
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"

# Seed Admin Credentials
ADMIN_EMAIL=admin@rishtaapp.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME="Super Admin"
